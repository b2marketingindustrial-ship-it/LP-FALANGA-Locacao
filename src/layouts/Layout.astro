---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import logoImg from '../assets/LOGO.png'
import '../styles/global.css'
// Mesmo arquivo do @font-face de global.css: o Vite dá a ele uma única URL com hash.
import manropeUrl from '../styles/fonts/manrope-latin.woff2?url'
import { site, title as defaultTitle, description as defaultDescription } from '../data/site'
import { hero } from '../data/content'

interface Props {
  title?: string
  description?: string
}

const { title = defaultTitle, description = defaultDescription } = Astro.props

// Preload do LCP: mesmas larguras/formatos que o <Picture> do Hero.
// Em AVIF, o primeiro formato do <Picture>: o navegador reaproveita o arquivo pré-carregado.
const avifSrcset = async (src: ImageMetadata, widths: number[]) =>
  (await Promise.all(widths.map((width) => getImage({ src, width, format: 'avif' }))))
    .map((img, i) => `${img.src} ${widths[i]}w`)
    .join(', ')
const heroBannerSrcset = await avifSrcset(hero.banner.src, [640, 1024, 1536, 1870])
const ogLogo = await getImage({ src: logoImg, width: 512, format: 'webp' })

const ogImage = new URL(ogLogo.src, site.url).href

// JSON-LD Organization: nome, URL, logo e endereço vêm de site.ts.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  url: site.url,
  logo: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressCountry: 'BR',
  },
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="b2-lp-standard" content={site.standardVersion} />
    <link rel="canonical" href={site.url} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImage} />

    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroBannerSrcset}
      imagesizes="(min-width: 1024px) 1660px, 700px"
      fetchpriority="high"
    />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent-orange focus:px-4 focus:py-2 focus:font-bold focus:text-white"
    >
      Pular para o conteúdo
    </a>
    <slot />
    {/* Sem botão flutuante de WhatsApp (regra das LPs Falanga, 23/10/2026). */}

    <script is:inline>
      // Parâmetros de depuração, usados pelos scripts de captura. Não fazem nada numa
      // visita normal — nenhum deles altera o HTML entregue ao visitante.
      {
        const params = new URLSearchParams(location.search)

        // ?screens=1 — a captura de página inteira não rola a página, então as imagens
        // `lazy` abaixo da dobra sairiam como buracos brancos. Com composições longas
        // isso é a regra, não a exceção.
        if (params.has('screens')) {
          for (const img of document.querySelectorAll('img[loading="lazy"]')) img.loading = 'eager'
        }

        // ?only=<id> — isola uma seção para o catálogo da biblioteca
        // (`node scripts/previews.mjs` no starter). Esconde o resto da página e tira a
        // barra fixa do topo, para a captura conter só a seção pedida.
        const only = params.get('only')
        if (only) {
          for (const el of document.querySelectorAll('body > *')) {
            if (el.tagName !== 'MAIN' && el.tagName !== 'SCRIPT') el.remove()
          }
          for (const section of document.querySelectorAll('main > *')) {
            if (section.id !== only) section.remove()
          }
        }
      }
    </script>
  </body>
</html>
