---
/**
 * Aluguel de compressores — fase "oferta".
 *
 * Falanga: seção feita na LP no lugar da vitrine (docs/BRIEFING.md, "Desvios"). Foto real
 * da frota com placa amarela deslocada e o selo de tradição; ao lado, a proposta da LP
 * antiga, os dois usos da locação em cards e o CTA "Falar com especialista".
 * Não existe na biblioteca: `npm run compose` não a conhece — restaure pelo git depois de
 * recompor.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { rental } from '@data/sections/locacao'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="locacao" tone={tone} rhythm={rhythm} class="relative overflow-hidden">
  <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16 xl:gap-20">
    {/* Foto da frota com placa amarela deslocada e o selo de tradição */}
    <div class="relative mx-auto w-full max-w-md pt-4 pl-4 sm:pt-5 sm:pl-5 lg:max-w-none">
      <span
        aria-hidden="true"
        class="absolute top-0 left-0 h-3/4 w-3/4 rounded-2xl bg-brand-yellow"
      ></span>
      <span aria-hidden="true" class="rental-lines absolute"></span>

      <div class="relative overflow-hidden rounded-2xl shadow-[0_34px_64px_-34px_rgba(0,24,48,0.6)]">
        <Image
          src={rental.photo.src}
          alt={rental.photo.alt}
          width={680}
          format="webp"
          loading="lazy"
          decoding="async"
          class="block aspect-square w-full object-cover"
        />
      </div>

      <p class="absolute -right-2 -bottom-7 flex items-center gap-3.5 rounded-xl bg-primary-dark-900 px-5 py-4 text-neutral-light shadow-[0_22px_40px_-18px_rgba(0,24,48,0.7)] sm:-right-6">
        <span class="font-display text-[2.6rem] leading-none font-extrabold text-brand-yellow">
          {rental.stat.value}
        </span>
        <span class="max-w-[9.5rem] font-sans text-[13px] leading-snug font-semibold text-neutral-light/85">
          {rental.stat.label}
        </span>
      </p>
    </div>

    {/* Proposta, usos e CTA */}
    <div>
      <span class="inline-flex items-center gap-2.5 font-sans text-[12px] font-bold tracking-[0.16em] text-brand uppercase sm:text-[13px]">
        <span aria-hidden="true" class="h-2 w-5 shrink-0 -skew-x-12 bg-brand-yellow"></span>
        {rental.eyebrow}
      </span>

      <h2 class="mt-3 font-display text-3xl leading-[1.1] font-extrabold tracking-[-0.015em] text-primary-dark-900 sm:text-4xl xl:text-[2.75rem]">
        {rental.title}
      </h2>

      <p class="mt-5 font-sans text-base leading-relaxed text-ink-soft sm:text-[17px]">
        {rental.text}
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {rental.items.map((item) => (
          <li class="rounded-xl border border-neutral-gray-200/40 bg-neutral-gray-100 p-5">
            <span class="flex size-11 items-center justify-center rounded-lg bg-brand text-brand-yellow">
              <Icon name={item.icon} class="size-[22px]" />
            </span>
            <span class="mt-4 block font-display text-[17px] leading-snug font-extrabold text-primary-dark-900">
              {item.title}
            </span>
            <span class="mt-1.5 block font-sans text-[14px] leading-relaxed text-ink-soft">
              {item.description}
            </span>
          </li>
        ))}
      </ul>

      <button
        type="button"
        data-cta="locacao-cta"
        class="btn-slave-whats rental-cta mt-8 inline-flex items-center justify-center gap-3 rounded-md bg-brand-yellow px-8 py-4 font-sans text-[16px] font-extrabold text-primary-dark-900 shadow-[0_16px_30px_-14px_rgba(180,160,0,0.8)] sm:text-[17px]"
      >
        {cta.card}
        <Icon name="arrow-right" class="size-5 shrink-0" />
      </button>
    </div>
  </div>
</Section>

<style>
  /* Riscos de velocidade da logo, saindo de trás da foto */
  .rental-lines {
    right: -28px;
    bottom: 22%;
    width: 120px;
    height: 58px;
    background: repeating-linear-gradient(180deg, var(--color-brand) 0 4px, transparent 4px 13px);
    mask-image: linear-gradient(to left, black 20%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, black 20%, transparent 100%);
  }

  .rental-cta {
    transition:
      transform 200ms ease-out,
      filter 200ms ease-out;
  }

  .rental-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .rental-cta {
      transition: none;
    }

    .rental-cta:hover {
      transform: none;
    }
  }
</style>
