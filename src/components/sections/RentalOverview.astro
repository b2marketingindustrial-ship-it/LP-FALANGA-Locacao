---
/**
 * Aluguel de compressores — fase "oferta".
 *
 * Falanga: seção feita na LP no lugar da vitrine (docs/BRIEFING.md, "Desvios"). Foto real
 * da frota com o selo "Desde 1981" e, ao lado, a proposta da LP antiga, os dois usos da
 * locação em cartões e o CTA "Falar com especialista". Abertura no molde das LPs de
 * manutenção e parafuso (27/10/2026): eyebrow com traço amarelo, título `title-section`,
 * foto em cartão de 16px com selo em pílula e cartões brancos com ícone em quadrado
 * amarelo-suave.
 * Não existe na biblioteca: `npm run compose` não a conhece — restaure pelo git depois de
 * recompor.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { rental } from '@data/sections/locacao'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="locacao" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-stretch lg:gap-12">
    {/* Foto da frota, com a altura da coluna de texto no desktop, e o selo em pílula */}
    <figure class="relative h-72 overflow-hidden rounded-2xl bg-neutral-gray-100 sm:h-96 lg:h-auto">
      <Image
        src={rental.photo.src}
        alt={rental.photo.alt}
        width={680}
        format="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover lg:absolute lg:inset-0"
      />
      <span class="absolute bottom-3 left-3 flex items-center gap-2 rounded-full bg-neutral-light px-3 py-2 font-sans text-[12px] font-bold text-brand-blue shadow-[0_10px_24px_-14px_rgba(0,33,71,0.6)] sm:bottom-4 sm:left-4 sm:px-4 sm:text-[13px]">
        <Icon name={rental.badge.icon} class="size-4 shrink-0 sm:size-5" />
        {rental.badge.label}
      </span>
    </figure>

    {/* Proposta, usos e CTA */}
    <div>
      <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase sm:text-[14px]">
        <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
        {rental.eyebrow}
      </p>

      <h2 class="mt-4 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-primary-dark">
        {rental.title}
      </h2>

      <p class="mt-5 max-w-xl font-sans text-lead text-ink-soft">{rental.text}</p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {rental.items.map((item) => (
          <li class="flex flex-col gap-3 rounded-2xl border border-brand-blue/10 bg-neutral-light p-4 shadow-[0_10px_30px_-24px_rgba(0,33,71,0.35)] xl:p-5">
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-yellow-soft text-[#00256f]">
                <Icon name={item.icon} class="size-5" />
              </span>
              <h3 class="font-display text-[16px] leading-tight font-extrabold text-brand-blue-dark">
                {item.title}
              </h3>
            </div>
            <p class="font-sans text-[14px] leading-relaxed text-ink-soft">{item.description}</p>
          </li>
        ))}
      </ul>

      <button type="button" data-cta="locacao-cta" class="btn-slave-whats cta cta-blue mt-8">
        {cta.card}
        <Icon name="arrow-right" class="shrink-0" />
      </button>
    </div>
  </div>
</Section>
