---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2.
 *
 * Falanga: bloco navy da fase de apoio, no painel do "Como funciona" das outras LPs Falanga
 * (27/10/2026): painel arredondado de 28px com brilho azul, eyebrow com traço amarelo e o
 * fim do título em amarelo. Título e texto à esquerda, botão amarelo à direita e, na base, a
 * faixa com os 6 dados do orçamento.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: restaure esta versão
 * depois de recompor.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { supportPanel } from '@data/sections/identificar'

type Props = SectionProps

const { tone, rhythm } = Astro.props

// O trecho em amarelo é o fim do título; o texto inteiro continua em `supportPanel.title`.
const cut = supportPanel.title.lastIndexOf(supportPanel.highlight)
const lead = cut >= 0 ? supportPanel.title.slice(0, cut).trimEnd() : supportPanel.title
const highlight = cut >= 0 ? supportPanel.highlight : ''
---

<Section id="identificar" tone={tone} rhythm={rhythm}>
  <div class="support-panel relative isolate overflow-hidden rounded-[28px] p-6 shadow-[0_24px_60px_-34px_rgba(0,24,48,0.8)] sm:p-8 lg:p-10">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="min-w-0 max-w-2xl">
        <p class="flex items-center gap-4 font-sans text-[13px] font-semibold tracking-[0.2em] text-[#8bcdff] uppercase">
          <span
            aria-hidden="true"
            class="h-[4px] w-10 shrink-0 rounded-full bg-brand-yellow"
          ></span>
          {supportPanel.eyebrow}
        </p>

        <h2 class="mt-3 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-neutral-light">
          {lead} {highlight && <span class="text-brand-yellow sm:block">{highlight}</span>}
        </h2>

        <p class="mt-4 font-sans text-lead text-neutral-light/75">{supportPanel.text}</p>
      </div>

      <div class="flex flex-col items-stretch gap-3 lg:shrink-0 lg:items-end">
        <button type="button" data-cta="identificar-cta" class="btn-slave-whats cta cta-yellow">
          {cta.primary}
          <Icon name="arrow-right" class="shrink-0" />
        </button>
        <span class="flex items-center justify-center gap-2 font-sans text-[14px] text-neutral-light/75 lg:justify-end">
          <Icon name="shield" class="size-5 shrink-0 text-brand-yellow" />
          {supportPanel.microcopy}
        </span>
      </div>
    </div>

    <p class="mt-10 font-sans text-[12px] font-semibold tracking-[0.18em] text-neutral-light/55 uppercase lg:mt-12">
      {supportPanel.itemsTitle}
    </p>
    <ul class="support-strip mt-4 grid grid-cols-2 rounded-xl border border-white/10 bg-white/[0.05] backdrop-blur-sm sm:grid-cols-3 xl:flex">
      {supportPanel.items.map((item) => (
        <li class="support-item flex flex-col items-start gap-2.5 px-4 py-4 sm:flex-row sm:items-center sm:gap-3.5 sm:px-5 sm:py-5 lg:gap-2.5 lg:px-3 lg:py-6 xl:flex-1 xl:justify-center xl:gap-3 xl:px-4">
          <Icon
            name={item.icon}
            class="size-7 shrink-0 text-brand-yellow sm:size-9 lg:size-8 xl:size-9"
          />
          <span class="flex min-w-0 flex-col gap-1">
            <span class="font-display text-[15px] leading-tight font-bold text-neutral-light sm:text-base xl:text-[17px] xl:whitespace-nowrap">
              {item.label}
            </span>
            <span class="font-sans text-[12px] leading-snug text-neutral-light/60 sm:text-[13px] xl:whitespace-nowrap">
              {item.hint}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  /* Fundo do painel, o mesmo do "Como funciona" das outras LPs: navy com um brilho azul no
     canto superior direito e na base. */
  .support-panel {
    background:
      radial-gradient(1000px 520px at 100% -10%, rgb(0 78 150 / 0.55) 0%, transparent 62%),
      radial-gradient(900px 320px at 55% 115%, rgb(0 80 150 / 0.6) 0%, transparent 70%),
      linear-gradient(160deg, #003770 0%, #012b59 45%, #002a5c 100%);
  }

  /* Divisórias internas, que não encostam no topo nem na base da faixa */
  .support-item {
    position: relative;
  }

  .support-item::after {
    content: '';
    position: absolute;
    top: 18%;
    right: 0;
    bottom: 18%;
    width: 1px;
    background: rgb(255 255 255 / 0.12);
  }

  .support-item:nth-child(2n)::after {
    display: none;
  }

  @media (width >= 40rem) {
    .support-item:nth-child(2n)::after {
      display: block;
    }

    .support-item:nth-child(3n)::after {
      display: none;
    }
  }

  @media (width >= 80rem) {
    .support-item:nth-child(3n)::after {
      display: block;
    }

    .support-item:last-child::after {
      display: none;
    }
  }
</style>
