---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto · janela do banner · shortcode.
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela.
 * Abra a página com `?grid=1` para ver as colunas e o início da foto.
 *
 * Hero no padrão das LPs Falanga (27/10/2026), no lugar do mockup claro de 22/10: fundo navy
 * com malha de blueprint; pílula com a frase de efeito, H1 com a palavra-chave como título
 * grande (branco, com o fim em amarelo), os quatro pontos numa barra de vidro, um único CTA do
 * sistema `cta` e a área atendida embaixo. Banner (compressores Schulz recortados sobre o navy) ancorado ao fim da coluna de
 * texto e esmaecido por uma elipse, hero com 100px de respiro acima e abaixo, conteúdo até
 * 1450px (--container-page), coluna de texto de largura fixa e shortcode do chat de 340px,
 * sem card. Registrado em docs/BRIEFING.md (Desvios do padrão).
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV
---

{/* Desktop: altura definida pelo conteúdo, com 100px de respiro acima dos textos e abaixo do botão. */}
<section
  class="hero relative overflow-hidden [container-type:inline-size] lg:flex lg:items-center"
  data-hero
>
  {/* z0 — malha de blueprint à esquerda */}
  <div aria-hidden="true" class="hero-blueprint pointer-events-none absolute inset-0 z-0"></div>

  {/* z1 — banner: faixa no rodapé da seção no mobile; no desktop, do fim da coluna de texto à borda da tela */}
  <div class="hero-photo hero-fade absolute inset-x-0 bottom-0 z-[1] h-[300px] lg:inset-y-0 lg:h-auto">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1536, 1870]}
      sizes="(min-width: 1024px) 1660px, 700px"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[60%_center]"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>

  {/* z5 — conteúdo */}
  <div class="page-container relative z-[5] pt-14 pb-[320px] lg:py-[100px]">
    <div class="hero-grid grid items-center gap-y-12 lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        {/* Pílula com a frase de efeito, como nas LPs de parafuso e manutenção */}
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-yellow/40 bg-white/[0.06] px-3 py-1 font-sans text-[11px] font-bold tracking-[0.12em] text-brand-yellow uppercase sm:text-[12px]">
          <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-brand-yellow"></span>
          {hero.pill}
        </p>

        {/* H1 com a palavra-chave da campanha como título grande: ela em branco e o fim da frase
            em amarelo, como nas LPs de parafuso e manutenção. */}
        <h1 class="mt-5 font-display text-[2rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[2.6rem] lg:text-[2.1rem] xl:text-[2.6rem] 2xl:text-[2.9rem]">
          <span class="block lg:whitespace-nowrap">{hero.title}</span>
          {hero.tail.map((line) => (
            <span class="block text-brand-yellow lg:whitespace-nowrap">{line}</span>
          ))}
        </h1>

        <p class="mt-5 max-w-[32rem] font-sans text-lead text-neutral-light/90">{hero.text}</p>

        {/* 4 pontos numa linha só, ícone ao lado do texto, numa barra de vidro com separadores
            (pedidos do usuário, 23/10/2026); texto sempre em duas linhas. Abaixo de 640px voltam
            à grade 2×2, por falta de largura. */}
        <ul class="hero-glass mt-8 grid grid-cols-2 gap-x-4 gap-y-4 rounded-2xl p-4 sm:flex sm:w-max sm:items-center sm:gap-0 sm:px-1 sm:py-3">
          {hero.points.map((point) => (
            <li class="flex items-center gap-2.5 sm:border-l sm:border-white/15 sm:px-4 sm:first:border-l-0">
              <Icon name={point.icon} class="size-9 shrink-0 text-brand-yellow sm:size-8" />
              <span class="font-sans text-[14px] leading-tight font-semibold text-neutral-light sm:text-[13px]">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <button type="button" data-cta="hero-primary" class="btn-slave-whats cta cta-yellow mt-9">
          {cta.primary}
          <Icon name="arrow-right" class="shrink-0" />
        </button>

        {/* Área atendida, separada por ponto */}
        <p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-sans text-[15px] font-medium text-neutral-light/90">
          {hero.area.map((item, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="text-neutral-light/60">
                  •
                </span>
              )}
              <span>{item}</span>
            </>
          ))}
        </p>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — só o shortcode do chat, sem card em volta (pedido do usuário, 23/10/2026).
          A altura de 340px só é reservada no desktop; no celular o chat ocupa o que renderizar. */}
      <div class="hero-chat w-full lg:w-[340px]">
        <div class="w-full lg:min-h-[340px]">
          <slot name="shortcode">
            {isDev ? (
              <div
                class="flex min-h-[340px] w-full flex-col gap-3 text-left"
                aria-label="Mock do chat (só em desenvolvimento)"
              >
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-yellow uppercase">
                  Mock · chat
                </span>
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="mt-auto h-12 rounded-full bg-brand-yellow" />
              </div>
            ) : (
              <div class="flex min-h-[340px] w-full flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-neutral-light/30 p-6 text-center">
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                  Espaço reservado
                </span>
                <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 300px</p>
              </div>
            )}
          </slot>
        </div>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0 hidden lg:block">
      <div class="absolute inset-y-0 left-0 border-l-2 border-dashed border-brand-yellow">
        <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] whitespace-nowrap text-brand-yellow">
          início da foto
        </span>
      </div>
    </div>
    <div class="page-container h-full">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-brand-yellow lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-yellow">
            col 2 · janela do banner · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 340px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Navy do mockup, um pouco mais claro no alto à esquerda, onde fica a malha. */
  .hero {
    background:
      radial-gradient(900px 520px at 22% 0%, rgb(0 92 190 / 0.32) 0%, transparent 62%),
      linear-gradient(180deg, #01264e 0%, #012751 55%, #012856 100%);
  }

  /* Barra de vidro dos 4 pontos: translúcida, com desfoque do que passa por trás (a malha
     e, no desktop, a borda da foto) e um filete de luz no alto. A base navy translúcida
     segura o contraste do texto quando a barra passa sobre o compressor e o piso claro. */
  .hero-glass {
    background-color: rgb(1 32 70 / 0.55);
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.12) 0%,
      rgb(255 255 255 / 0.04) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 18px 40px -24px rgb(0 0 0 / 0.7);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  /* Malha de blueprint do mockup: linhas finas, mais fortes no alto à esquerda. */
  .hero-blueprint {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 55% 75% at 18% 22%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 55% 75% at 18% 22%, #000 0%, transparent 78%);
  }

  /* Borda da página (conteúdo até --container-page, padding de 48px) e fim da coluna de texto. */
  .hero-photo,
  .hero-grid {
    --page-max: var(--container-page);
    --page-edge: max(0px, calc(50% - var(--page-max) / 2));
    --text-col: 540px;
    --col-end: calc(var(--page-edge) + 3rem + var(--text-col));
    /* Quanto a foto começa antes do fim da coluna de texto. */
    --photo-pull: 60px;
  }

  /* Mobile: a faixa da foto no rodapé do hero nasce do fundo navy, sem borda reta. */
  .hero-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
    mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
  }

  @media (min-width: 1024px) {
    /* Col 1 texto (largura fixa) | Col 2 janela do banner | Col 3 shortcode */
    .hero-grid {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) 340px;
    }

    /* A foto vai de um pouco antes do fim da coluna de texto até a coluna do chat (26/10/2026): */
    /* o shortcode tem 340px reservados e os produtos do banner não podem ficar embaixo dele. */
    /* A caixa passa 180px de cada lado (--photo-bleed) só para o esmaecimento acontecer ali, */
    /* sobre o navy, e não em cima dos produtos. Banner enquadrado em 60% na horizontal. */
    .hero-photo {
      --photo-bleed: 180px;
      left: calc(var(--col-end) - var(--photo-pull) - var(--photo-bleed));
      right: calc(var(--page-edge) + 3rem + 340px - var(--photo-bleed));
    }

    /* A foto se dissolve no navy por uma elipse, e não por faixas retas: as bordas somem */
    /* aos poucos nos quatro lados, sem linha visível. Máscara, e não véu, para não haver cor */
    /* a casar. Paradas próximas imitam uma curva suave (ease-out) em vez de uma rampa linear. */
    .hero-fade {
      -webkit-mask-image: radial-gradient(
        ellipse 50% 78% at 52% 56%,
        #000 0%,
        #000 38%,
        rgb(0 0 0 / 0.9) 48%,
        rgb(0 0 0 / 0.72) 58%,
        rgb(0 0 0 / 0.5) 68%,
        rgb(0 0 0 / 0.28) 78%,
        rgb(0 0 0 / 0.12) 88%,
        rgb(0 0 0 / 0.03) 95%,
        transparent 100%
      );
      mask-image: radial-gradient(
        ellipse 50% 78% at 52% 56%,
        #000 0%,
        #000 38%,
        rgb(0 0 0 / 0.9) 48%,
        rgb(0 0 0 / 0.72) 58%,
        rgb(0 0 0 / 0.5) 68%,
        rgb(0 0 0 / 0.28) 78%,
        rgb(0 0 0 / 0.12) 88%,
        rgb(0 0 0 / 0.03) 95%,
        transparent 100%
      );
    }
  }

  /* Telas largas: a foto puxa mais para a esquerda, para a janela entre o texto e o chat crescer. */
  @media (min-width: 1536px) {
    .hero-photo,
    .hero-grid {
      --text-col: 560px;
      --photo-pull: 100px;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
