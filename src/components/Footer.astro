---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.5). Uma linha: copyright · endereço · crédito da B2.
 * Sem menu, redes, telefone, e-mail, logo ou formulário.
 *
 * Correção de 22/10/2026 (defeito 5 em docs/BRIEFING.md): o endereço tinha
 * `lg:whitespace-nowrap` e os dois textos, `shrink-0`. A partir de `lg` nada podia
 * encolher nem quebrar e, com um endereço de duas unidades (Fortaleza e Recife), a
 * linha pedia 1112px num viewport de 1024 — rolagem horizontal na página inteira.
 * Agora o endereço quebra quando falta espaço (`min-w-0` para poder encolher no flex)
 * e volta a uma linha só quando cabe, em `xl`. O layout em 1440px e acima não muda.
 */
import Icon from './Icon.astro'
import { site } from '../data/site'
import { footer } from '../data/content'

const year = new Date().getFullYear()
---

<footer class="navy-premium border-t border-white/15">
  <div class="page-container flex flex-col items-center gap-3 py-6 text-center lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:text-left">
    <p class="shrink-0 font-sans text-xs text-neutral-light/55">
      © {year} {site.brand}. Todos os direitos reservados.
    </p>

    <address class="flex min-w-0 items-center gap-2 font-sans text-xs text-neutral-light/70 not-italic xl:whitespace-nowrap">
      <Icon name="map-pin" class="size-3.5 shrink-0 text-brand-yellow" />
      <span>{site.address}</span>
    </address>

    <p class="shrink-0 font-sans text-xs text-neutral-light/55">
      Desenvolvido por{' '}
      <a
        href={footer.credit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-neutral-light/80 transition-colors hover:text-brand-yellow"
      >
        {footer.credit.label}
      </a>
    </p>
  </div>
</footer>
