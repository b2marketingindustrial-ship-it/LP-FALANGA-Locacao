---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1), na versão Falanga.
 *
 * Mesmo desvio do padrão aprovado na LP Spinplus (docs/BRIEFING.md, "Desvios"): header
 * claro com filete — aqui amarelo —, logo sem placa pendurada, produto ao centro, selo
 * regional e a marca Schulz à direita. Sem botão de cotação: o CTA do hero está logo
 * abaixo. Muda só o conteúdo, que vem de `site` e `header` (content.ts).
 */
import { Image } from 'astro:assets'
import logo from '../assets/LOGO.png'
import { site } from '../data/site'
import { header } from '../data/content'
---

<header
  class="sticky top-0 z-50 border-b-[3px] border-brand-yellow bg-neutral-light shadow-[0_8px_20px_-14px_rgba(0,24,48,0.4)]"
  data-header="falanga"
>
  <div class="mx-auto flex max-w-page items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:gap-8 lg:px-10">
    {/* 1. Logo */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={341}
        height={82}
        format="webp"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="h-10 w-auto sm:h-12 lg:h-[52px]"
      />
    </a>

    <span aria-hidden="true" class="hidden h-12 w-px bg-neutral-gray-200/50 md:block"></span>

    {/* 2. Produto (some no mobile) */}
    <span class="hidden flex-1 font-display text-lg font-extrabold tracking-[0.01em] text-primary-dark-900 uppercase md:block lg:text-[22px]">
      {header.tagline}
    </span>

    <span aria-hidden="true" class="hidden h-12 w-px bg-neutral-gray-200/50 xl:block"></span>

    {/* 3. Selo regional (desktop largo) */}
    <p class="hidden shrink-0 flex-col items-center gap-1 text-center xl:flex">
      <span class="bg-brand-yellow px-2.5 py-0.5 font-sans text-[13px] font-extrabold tracking-[0.02em] text-primary-dark-900 uppercase">
        {header.badge}
      </span>
      <span class="font-sans text-[12px] font-bold tracking-[0.04em] text-ink-soft uppercase">
        {header.badgeSub}
      </span>
    </p>

    {/* 4. Marca parceira */}
    <Image
      src={header.partner.src}
      alt={header.partner.alt}
      width={317}
      height={80}
      format="webp"
      loading="eager"
      fetchpriority="low"
      decoding="async"
      class="h-7 w-auto shrink-0 sm:h-8 lg:h-9"
    />
  </div>
</header>
