---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1), na versão Falanga: barra branca com a logo
 * alinhada dentro dela e CTA em pílula amarela com texto navy. Sem menu: uma rota, uma
 * página (regra 1). Registrado em docs/BRIEFING.md (Desvios do padrão).
 *
 * Acabamento da LP de compressores de parafuso (22–23/10/2026), levado para esta LP: filete
 * amarelo-azul no topo, largura do conteúdo da página (`page-container`), logo 20% menor,
 * tagline com selo, CTA do sistema `cta` e sombra só depois que a página rola
 * (`data-scrolled`). A logo da Schulz ao lado da Falanga, como na LP de parafuso, volta a pedido do
 * usuário em 27/10/2026.
 * Alinhado ao padrão das outras LPs Falanga em 27/10/2026, no lugar do header claro do mockup
 * da Spinplus (sem CTA, selo regional e logo Schulz).
 * Muda só: logos (src/assets/LOGO.png, src/assets/schulz.png), tagline (content.header) e rótulos (content.header, content.cta).
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/LOGO.png'
import schulzLogo from '../assets/schulz.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header data-header class="site-header sticky top-0 z-50 bg-neutral-light/95 backdrop-blur-md">
  <span
    aria-hidden="true"
    class="block h-[3px] bg-[linear-gradient(90deg,var(--color-brand-yellow)_0%,var(--color-brand-yellow)_40%,var(--color-brand-blue)_100%)]"
  ></span>
  <div class="page-container flex items-center justify-between gap-3 py-3 sm:gap-6">
    {/* 1. Logo da Falanga, 20% menor que a do padrão, e, separada por um filete, a da Schulz. A da
        Schulz some abaixo de 640px, onde não cabe ao lado do CTA. */}
    <div class="flex shrink-0 items-center gap-5 lg:gap-6">
      <a href="/" class="flex shrink-0 items-center">
        <Image
          src={logo}
          alt={site.brand}
          width={341}
          height={82}
          format="webp"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="header-logo h-8 w-auto sm:h-[45px]"
        />
      </a>
      <span aria-hidden="true" class="hidden h-8 w-px bg-primary-dark/15 sm:block"></span>
      <Image
        src={schulzLogo}
        alt="Schulz"
        width={240}
        format="webp"
        loading="eager"
        decoding="async"
        class="hidden h-[19px] w-auto sm:block lg:h-[22px]"
      />
    </div>

    {/* 2. Tagline com selo, centrada entre as logos e o CTA (some no mobile) — no lugar do menu do mockup */}
    <div class="hidden flex-1 items-center justify-center gap-6 lg:flex">
      <span class="flex items-center gap-2.5 font-display text-[13px] font-extrabold tracking-[0.14em] text-primary-dark uppercase">
        <span class="flex size-7 items-center justify-center rounded-full bg-brand-yellow-soft text-[#00256f]">
          <Icon name="badge-check" class="size-4" />
        </span>
        {header.tagline}
      </span>
    </div>

    {/* 3. CTA em pílula amarela, rótulo curto no mobile */}
    <button type="button" data-cta="header-cta" class="btn-slave-whats cta cta-yellow cta-sm">
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{header.cta}</span>
      <Icon name="arrow-right" class="shrink-0" />
    </button>
  </div>
</header>

<style>
  /* Linha fina enquanto a página está no topo; sombra quando o conteúdo passa por baixo. */
  .site-header {
    box-shadow: 0 1px 0 rgb(0 33 71 / 0.08);
    transition: box-shadow 0.25s ease;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 14px 30px -20px rgb(0 33 71 / 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  // Sombra do header só depois que a página rola.
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((el) => {
    const update = () => el.toggleAttribute('data-scrolled', window.scrollY > 8)
    update()
    window.addEventListener('scroll', update, { passive: true })
  })
</script>
